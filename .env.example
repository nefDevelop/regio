# ⚠️  ADVERTENCIA DE SEGURIDAD  ⚠️
# Este archivo es una plantilla. NUNCA uses estos valores en producción.
# Genera tu propia MASTER_KEY con: openssl rand -base64 32
#
# ADMIN_DOMAIN: Dominio público del panel de administración
# MASTER_KEY:   Clave maestra para cifrar secretos TOTP (mínimo 32 caracteres, usar aleatorio)
# TRUSTED_PROXIES: IPs o CIDR de proxies reversos (Cloudflare, Nginx, etc.)

ADMIN_DOMAIN=admin.tudominio.com
MASTER_KEY=cambia_esta_clave_por_una_generada_con_openssl_rand
TRUSTED_PROXIES=127.0.0.1

# Opcionales:
# TLS_CERT=ruta/al/certificado.pem
# TLS_KEY=ruta/al/certificado.key
# FORCE_HTTPS=true
# ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16
# PORT=80
# PORT_TLS=443
