# --- CONFIGURACIÓN OBLIGATORIA ---
ADMIN_DOMAIN=admin.tudominio.com
MASTER_KEY=GeneraUnaClaveLargaYAleatoriaDeAlMenos32Caracteres!

# --- SEGURIDAD DE RED ---
